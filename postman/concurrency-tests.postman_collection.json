    {
      "name": "Stress - Rapid Fire Telemetry",
      "description": "Sends 50 rapid telemetry events to stress-test the POST endpoint. Run with Collection Runner.",
      "item": [
        {
          "name": "Generate 50 rapid telemetry events",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('All rapid-fire events accepted', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Store the response for validation",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('last_telemetry_id', body.id);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate random vehicle and zone for variety",
                  "const vehicleNum = Math.floor(Math.random() * 50) + 1;",
                  "const zones = ['aisle_a', 'aisle_b', 'aisle_c', 'pick_zone_1', 'pick_zone_2', 'charging_bay_1'];",
                  "const randomZone = zones[Math.floor(Math.random() * zones.length)];",
                  "const statuses = ['moving', 'idle', 'charging'];",
                  "const randomStatus = statuses[Math.floor(Math.random() * statuses.length)];",
                  "",
                  "const payload = {",
                  "    vehicle_id: `v-${vehicleNum.toString().padStart(2, '0')}`,",
                  "    timestamp: new Date().toISOString().replace('\\\\Z', 'Z'),",
                  "    lat: 37.4 + Math.random() * 0.1,",
                  "    lon: -122.1 + Math.random() * 0.1,",
                  "    battery_pct: Math.floor(Math.random() * 100),",
                  "    speed_mps: Math.random() * 5,",
                  "    status: randomStatus,",
                  "    error_codes: [],",
                  "    zone_entered: Math.random() > 0.7 ? randomZone : null",
                  "};",
                  "",
                  "pm.request.body.raw = JSON.stringify(payload);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/telemetry",
              "host": ["{{base_url}}"],
              "path": ["api", "telemetry"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    }
  ]
}
