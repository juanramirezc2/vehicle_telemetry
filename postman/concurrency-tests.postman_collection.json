{
  "info": {
    "name": "Fleet Telemetry - Concurrency Tests",
    "description": "Postman collection for testing concurrent write scenarios on the fleet telemetry API.\n\nIMPORTANT: For true parallel execution, use the Postman Collection Runner with concurrency > 1, or run the included Python concurrency test script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Setup - Seed Vehicles",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API is healthy', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Vehicles (verify seed)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/vehicles",
              "host": ["{{base_url}}"],
              "path": ["api", "vehicles"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vehicles exist', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const vehicles = pm.response.json();",
                  "    pm.expect(vehicles.length).to.be.above(0);",
                  "    // Store first vehicle ID for later tests",
                  "    if (vehicles.length > 0) {",
                  "        pm.collectionVariables.set('test_vehicle_id', vehicles[0].id);",
                  "        pm.collectionVariables.set('test_vehicle_id_2', vehicles[1] ? vehicles[1].id : vehicles[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Concurrency - Telemetry Burst",
      "description": "Tests concurrent telemetry ingestion from multiple vehicles. Use Collection Runner with concurrency=10+ to simulate real burst.",
      "item": [
        {
          "name": "Concurrent Telemetry - Vehicle A (zone_entered)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/telemetry",
              "host": ["{{base_url}}"],
              "path": ["api", "telemetry"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": \"v-1\",\n  \"timestamp\": \"{{$timestamp}}000Z\",\n  \"lat\": 37.41,\n  \"lon\": -122.08,\n  \"battery_pct\": 78,\n  \"speed_mps\": 1.2,\n  \"status\": \"moving\",\n  \"error_codes\": [],\n  \"zone_entered\": \"aisle_a\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Telemetry accepted (201)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has valid structure', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body).to.have.property('vehicle_id', 'v-1');",
                  "    pm.expect(body).to.have.property('received_at');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Concurrent Telemetry - Vehicle B (zone_entered same zone)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/telemetry",
