    {
      "name": "Verify - Fleet State Consistency",
      "description": "Verifies that fleet-wide aggregates are consistent under concurrent updates.",
      "item": [
        {
          "name": "GET /vehicles - Per-status counts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/vehicles",
              "host": ["{{base_url}}"],
              "path": ["api", "vehicles"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Fleet state returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const vehicles = pm.response.json();",
                  "    pm.expect(vehicles).to.be.an('array');",
                  "    pm.expect(vehicles.length).to.be.above(0);",
                  "",
                  "    // Count vehicles per status",
                  "    const statusCounts = {};",
                  "    vehicles.forEach(v => {",
                  "        statusCounts[v.status] = (statusCounts[v.status] || 0) + 1;",
                  "    });",
                  "",
                  "    // Verify total matches",
                  "    const total = Object.values(statusCounts).reduce((a, b) => a + b, 0);",
                  "    pm.expect(total).to.equal(vehicles.length);",
                  "",
                  "    console.log('Fleet status breakdown:', JSON.stringify(statusCounts));",
                  "    console.log('Total vehicles:', total);",
                  "",
                  "    // All vehicles should have a valid status",
                  "    const validStatuses = ['idle', 'moving', 'charging', 'fault'];",
                  "    vehicles.forEach(v => {",
                  "        pm.expect(validStatuses).to.include(v.status);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
