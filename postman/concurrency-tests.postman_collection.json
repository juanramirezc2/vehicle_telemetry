    {
      "name": "Verify - Zone Counter Atomicity",
      "description": "After the burst above, 3 vehicles entered aisle_a. Verify count is exactly 3.",
      "item": [
        {
          "name": "GET /zones/counts - Verify aisle_a count",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/zones/counts",
              "host": ["{{base_url}}"],
              "path": ["api", "zones", "counts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Zone counts returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const zones = pm.response.json();",
                  "    pm.expect(zones).to.be.an('array');",
                  "    pm.expect(zones.length).to.equal(20);",
                  "});",
                  "",
                  "pm.test('aisle_a count is exactly 3 (atomic increment check)', function () {",
                  "    const zones = pm.response.json();",
                  "    const aisleA = zones.find(z => z.zone_id === 'aisle_a');",
                  "    pm.expect(aisleA).to.not.be.undefined;",
                  "    pm.expect(aisleA.entry_count).to.equal(3);",
                  "});",
                  "",
                  "pm.test('charging_bay_1 count is exactly 1', function () {",
                  "    const zones = pm.response.json();",
                  "    const chargingBay = zones.find(z => z.zone_id === 'charging_bay_1');",
                  "    pm.expect(chargingBay).to.not.be.undefined;",
                  "    pm.expect(chargingBay.entry_count).to.equal(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
